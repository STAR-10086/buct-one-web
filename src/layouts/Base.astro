---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/glass.css';
import '../styles/capsules.css';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; }
const { title, description = 'BUCT One · 北化一站 —— 北化人的原生液态玻璃校园工作台。本地优先，零商业埋点。' } = Astro.props;
const site = Astro.site?.origin ?? 'https://buct.one';
const canonical = new URL(Astro.url.pathname, site).href;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#F0F2F4" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0F1218" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="BUCT One · 北化一站" />
  <meta name="twitter:card" content="summary_large_image" />
  <ClientRouter />
  <script defer src="https://stats.buct.one/script.js" data-website-id="b2a24b1d-e825-4273-9e68-2f2a4788529b"></script>
  <script is:inline>
    (function () {
      function applyBootAttrs() {
        var root = document.documentElement;
        root.classList.add('js-ready');
        try {
          var m = localStorage.getItem('buctone.theme');
          var dark = m === 'dark' || ((m === null || m === 'auto') && matchMedia('(prefers-color-scheme: dark)').matches);
          root.dataset.theme = dark ? 'dark' : 'light';
          var g = localStorage.getItem('buctone.glass');
          root.dataset.glassChoice = (g === 'full' || g === 'blur' || g === 'solid') ? g : 'auto';
        } catch (e) {
          root.dataset.theme = 'light';
        }
      }
      applyBootAttrs();
      if (!window.__buctBootBound) {
        window.__buctBootBound = true;
        document.addEventListener('astro:after-swap', applyBootAttrs);
      }
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">跳到主要内容</a>
  <div class="ambient-bg" aria-hidden="true" transition:persist="ambient">
    <span class="ambient-orb orb-1"></span>
    <span class="ambient-orb orb-2"></span>
    <span class="ambient-orb orb-3"></span>
  </div>
  <Dock />
  <main id="main" transition:name="main">
    <slot />
  </main>
  <Footer />
  <div data-toast-host transition:persist="toast"></div>
  <script>
    import { initThemeControls, cycleGlass, readGlass } from '../lib/theme';
    import { initGlass, cleanupGlass, reinitGlass } from '../lib/liquid-glass';
    import {
      initReveal,
      initSpotlight,
      initHeroTilt,
      initSmoothDetails,
      initShotLightbox,
      cleanupMotion,
    } from '../lib/motion';
    import { showToast } from '../lib/release';

    const GLASS_LABEL: Record<string, string> = { auto: '自动', full: '完整折射', blur: '毛玻璃', solid: '纯色' };

    function mountPage() {
      initThemeControls();
      initGlass();
      initReveal();
      initSpotlight();
      initHeroTilt();
      initSmoothDetails();
      initShotLightbox();

      document.querySelectorAll<HTMLButtonElement>('[data-glass-toggle]').forEach((btn) => {
        const label = () => {
          btn.textContent = '玻璃：' + (GLASS_LABEL[readGlass()] ?? '自动');
        };
        label();
        if (btn.dataset.glassBound === '1') return;
        btn.dataset.glassBound = '1';
        btn.addEventListener('click', () => {
          const next = cycleGlass();
          reinitGlass();
          label();
          showToast('玻璃效果：' + (GLASS_LABEL[next] ?? '自动'));
        });
      });
    }

    const w = window as unknown as { __buctBaseBound?: boolean };
    if (!w.__buctBaseBound) {
      w.__buctBaseBound = true;
      document.addEventListener('astro:before-swap', () => {
        cleanupGlass();
        cleanupMotion();
      });
      document.addEventListener('astro:page-load', mountPage);
    }
  </script>
</body>
</html>
