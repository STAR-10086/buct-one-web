---
import snapshot from '../data/release-snapshot.json';
import Icon from './Icon.astro';
import Sha256Row from './Sha256Row.astro';
import { miniMarkdown } from '../lib/release';

const r = snapshot as any;
const tag = r.tag || ('v' + r.version);
const sizeText = r.sizeBytes > 0 ? (r.sizeBytes / 1048576).toFixed(1) + ' MB' : '—';
const dateText = String(r.publishedAt || '').slice(0, 10);

// 硬编码 R2 latest 固定短链，零 R2 元数据查询开销
const r2LatestApkUrl = 'https://dl.buct.one/apk/latest/arm64-v8a/buct-one-latest.apk';
const githubApkUrl = `https://github.com/STAR-10086/buct-one/releases/download/${tag}/buct-one-${tag}-arm64-v8a.apk`;
const githubReleaseUrl = r.githubReleaseUrl || `https://github.com/STAR-10086/buct-one/releases/tag/${tag}`;
const changelogHtml = r.changelogMd ? miniMarkdown(r.changelogMd) : '';
---
<section class="release">
  <div class="cap-chip version-chip">
    <strong data-rel="version">{'v' + r.version}</strong>
    <span data-rel="date">{dateText}</span>
    <span data-rel="size">{sizeText}</span>
    <span class="cap-chip badge">最新正式版</span>
  </div>
  <div class="grid grid-2 sources">
    <article class="glass-content cap-card source-card">
      <h3>Cloudflare R2 下载 <span class="cap-chip soon">推荐</span></h3>
      <p>国内与校园网高速直连，固定拉取最新正式版安装包（arm64-v8a）。</p>
      <a class="btn btn-primary btn-lg" href={r2LatestApkUrl} data-jelly>
        <Icon name="download" /> 通过 Cloudflare R2 下载
      </a>
    </article>
    <article class="glass-content cap-card source-card">
      <h3>GitHub 下载</h3>
      <p>从 GitHub Release 源下载当前版本安装包（<a href={githubReleaseUrl} target="_blank" rel="noopener" class="release-link">查看其它架构与历史版本 →</a>）。</p>
      <a class="btn btn-secondary btn-lg" href={githubApkUrl} target="_blank" rel="noopener">
        <Icon name="github" /> 通过 GitHub 下载
      </a>
    </article>
  </div>
  <Sha256Row sha={r.sha256} />
  {changelogHtml && (
    <div class="glass-content cap-card changelog-preview">
      <h4>本版更新</h4>
      <div class="md" set:html={changelogHtml} />
      <a href="/changelog" class="label">查看完整更新日志 →</a>
    </div>
  )}
</section>
<style>
  .release { display: grid; gap: 16px; min-width: 0; max-width: 100%; }
  .version-chip { height: auto; min-height: 36px; flex-wrap: wrap; padding: 6px 12px; gap: 10px; color: var(--on-glass); }
  .version-chip strong { font-size: 14px; }
  .badge { height: 22px; padding: 0 8px; border-radius: 11px; font-size: 11px; background: var(--primary-container); color: var(--primary); border: 0; }
  .source-card { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .changelog-preview { min-width: 0; }
  .source-card h3 { display: flex; align-items: center; gap: 8px; color: var(--on-glass); }
  .source-card p { font-size: 14px; color: var(--on-glass-variant); }
  .release-link { color: var(--primary); text-decoration: none; }
  .release-link:hover { text-decoration: underline; }
  .changelog-preview { display: grid; gap: 10px; }
  .md :global(h3), .md :global(h4) { font-size: 16px; margin: 8px 0 4px; color: var(--on-glass); }
  .md :global(ul) { padding-left: 20px; display: grid; gap: 4px; }
  .md :global(li), .md :global(p) { font-size: 14px; line-height: 20px; color: var(--on-glass-variant); }
  .md :global(code) { font-family: var(--font-mono); font-size: 12px; }
  .md :global(table) { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 12px; display: block; overflow-x: auto; }
  .md :global(th), .md :global(td) { border: 1px solid var(--glass-border); padding: 6px 8px; text-align: left; vertical-align: top; color: var(--on-glass-variant); white-space: nowrap; }
  .md :global(th) { background: var(--glass-control); color: var(--on-glass); font-weight: 600; }
</style>
<script>
  import { initCopySha } from '../lib/release';
  initCopySha();
</script>
