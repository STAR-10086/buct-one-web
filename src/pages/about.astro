---
import Base from '../layouts/Base.astro';
import GlassCard from '../components/GlassCard.astro';

const faqs = [
  ['支持哪些学校？', '面向北京化工大学（BUCT），接入 sidportal 统一身份认证与教务（含教务消息）、北化在线、i北化（官方校历/校内资讯/图书在借）、第二课堂、实践教学、体测与体育、校园邮箱、校园一卡通、宿舍电费与校园网网费。'],
  ['本科与研究生教务有何区别？', '在「我的 → 教务系统（本科 / 研究生）」切换本科（jwglxt）或研究生（gmis），课表、成绩与培养方案分别适配。'],
  ['第二课堂、校园网为何需要校园网或 VPN？', '第二课堂、i北化、校园卡、校园网网费（tree.buct.edu.cn 含 :8800）与研究生教务等 7 个仅限校内的域名，App 内置混合 DNS（BuctDns）与直连优先 WebVPN 自动降级（w.buct.edu.cn）：校内直接连，校外受阻时自动切到 WebVPN 并支持原生短信二次验证。'],
  ['忘记密码怎么办？', 'App 绝不存储明文密码，请通过学校统一身份认证门户找回；若开启本机记住凭据，密文由 Android Keystore（AES-256-GCM）独立别名加密保管且排除云备份，认证失败或退出登录即刻擦除。'],
  ['数据多久同步一次？', '本地优先：同步失败绝不清空旧缓存；北化在线采用两阶段后台静默同步，各模块均支持工作台一键刷新与跨模块 SsoSilentRelogin 静默续期。'],
  ['如何更新 App？', '正式版接入 update.buct.one，支持冷启动检测与「我的 → 应用与支持 → 检查更新」手动检查；按设备 ABI 自动匹配包并执行 SHA-256 与正式签名双重校验。重要版本通知与公告也可在「我的 → 官方公告」随时查看。'],
  ['匿名使用统计收集什么？', '仅通过自托管 Umami（stats.buct.one）与本地随机 UUIDv4 统计每日启动心跳与模块热度，绝不采集学号、姓名、Cookie 或硬件指纹，可在「我的 → 数据与安全」随时关闭。'],
  ['抢课会不会给教务造成压力？', '定时队列按合理并发与间隔请求，不做高风险全自动刷单或代打卡操作，避免对教务系统造成冲击。'],
  ['如何贡献代码？', '欢迎在 GitHub 提 Issue 与 PR；项目遵循 GPL-3.0，贡献即视为同意该许可。'],
  ['GPL-3.0 对我意味着什么？', '你可以自由使用、学习与修改源码；分发衍生作品需同样以 GPL-3.0 开源。'],
];

const roadmap = [
  {
    accent: 3,
    badge: '已在 v0.3.6 上线',
    title: '北化在线独立课程与课件资料',
    desc: '已上线独立课程中心：支持全部在读课程搜索、单元学习与课程资源目录浏览、端内在线预览与原生会话下载打开。',
  },
  {
    accent: 1,
    badge: '本地提醒与公告已上线',
    title: '轻量智能提醒与官方公告',
    desc: '已落地纯本地智能提醒、桌面倒计时组件与 notice.buct.one 官方公告通道，后续继续完善低频后台变更提醒，绝不上云存储个人凭据或引入商业推送 SDK。',
  },
  {
    accent: 4,
    badge: '开发中',
    title: 'BUCT One iOS 版',
    desc: '正在推进原生 iOS 客户端开发，逐步对齐课表、成绩、北化在线、宿舍电费等核心校园功能。',
  },
  {
    accent: 5,
    badge: '已在 v0.3.4 上线',
    title: '宿舍电费与校园网网费查询',
    desc: '已接入 ele.buct.one（昌平/东区双表/西区宿舍电费，含学号签名防滥用说明）与 tree.buct.edu.cn（校园网余额/钱包/流量/缴费与月结算账单，支持 WebVPN 降级）。',
  },
  {
    accent: 2,
    badge: '调研 / 规划中',
    title: '通勤班车时刻表与轻导航',
    desc: '内置东区 ↔ 昌平通勤班车时刻表（区分工作日/周末/寒暑假与下一班倒计时）及常用校内官方服务快捷入口。',
  },
  {
    accent: 7,
    badge: '规划中',
    title: '学业 GPA 试算与一卡通洞察',
    desc: '结合培养方案支持目标 GPA 试算与学分缺口统计；纯 Compose Canvas 绘制月度消费趋势与类别分布，严守 APK 体积预算。',
  },
];

const credits = [
  ['zhengfang-apk', 'GPL-3.0', '液态玻璃界面体系、胶囊导航、教务解析与小组件架构'],
  ['beihua-kebiao', 'GPL-3.0', '北化原生 sidportal 认证、BuctTlsTrustManager 信任链与教务适配'],
  ['go-buct-course / BUCT-course-remind', 'MIT', '北化在线协议与待办建模参考'],
  ['THEIA', 'MIT', '校园工作台形态与数据溯源设计思想'],
  ['Phosphor Icons', 'MIT', '双色矢量导航图标语言'],
  ['Kyant Backdrop', 'Apache-2.0', 'Compose 液态玻璃材质基础'],
  ['shuding/liquid-glass · xiaofangstudio/liquid-glass-web', 'MIT', '官网折射引擎算法与交互动效参考'],
];
---
<Base title="关于 · BUCT One" description="关于 BUCT One：隐私架构、演进路线规划、常见问题、上游致谢与联系方式。">
  <section class="wrap section about-head">
    <div data-reveal>
      <p class="eyebrow">About</p>
      <h1>关于 BUCT One</h1>
      <p class="lead">BUCT One · 北化一站是北化学生开发维护的开源校园工作台，以原生液态玻璃界面串起校内各系统。本项目非学校官方应用。</p>
    </div>
  </section>

  <section class="wrap section" id="privacy">
    <div class="section-head" data-reveal><h2>隐私架构</h2></div>
    <div class="glass-content cap-card spotlight-card" data-spotlight data-reveal>
      <pre class="mono arch">sidportal 原生认证 ──┬─→ 教务（课表 / 成绩 / 培养方案 / 考试 / 选课 / 教务消息）
                    ├─→ i北化（官方校历自动校准 / 校内四栏资讯 / 图书馆在借）
                    ├─→ 北化在线（独立课程 / 课件资源 / 作业 / 测验 / 附件）
                    ├─→ 实践教学（实验课表 / 抢讲座 / 创新学分）
                    ├─→ 第二课堂（五育综测 / 二课活动）
                    ├─→ 体测与体育（体测成绩 / 阳光跑 / 国标算分）
                    └─→ 校园邮箱（收件箱 / 未读同步 / 删除还原 / 附件）
校园一卡通 ───────────→ 独立会话（余额 / 流水 / Keystore 加密静默续期）
ele.buct.one ─────────→ 宿舍电费网关（全校电费 / 东区双表 / 显式授权学号防滥用）
tree.buct.edu.cn ─────→ 校园网网费与账单（余额 / 钱包 / 流量 / 缴费与月账单）
notice.buct.one ──────→ 官方公告通道（只读 Markdown 图文公告 / 零个人凭据）
        │
   分域采集 → 版本化解析 → 原子落盘（失败不覆盖旧快照）→ 界面与小组件</pre>
      <ul class="privacy-points">
        <li>业务请求全程直连校方服务器，无第三方商业埋点 SDK（仅含自托管 Umami 零 PII 匿名统计，支持在设置中随时关闭）。</li>
        <li>明文绝不落盘，内存 char[] 用后清零；各会话凭据 Vault 各自采用独立 Android Keystore（AES-256-GCM）别名加密保管，认证失败或退出登录立即擦除。</li>
        <li>全网强制校方证书链（BuctTlsTrustManager），CI 静态禁止 trustAllCerts 与放行任意 HostnameVerifier。</li>
        <li>备份规则显式排除全部 Vault 文件防止云备份带出；日志自动掩码学号、姓名与成绩数值。</li>
      </ul>
    </div>
  </section>

  <section class="wrap section" id="roadmap">
    <div class="section-head" data-reveal>
      <h2>演进路线</h2>
      <a href="/changelog" class="label">查看已发布版本 →</a>
    </div>
    <div class="grid grid-2">
      {roadmap.map((item) => (
        <GlassCard accent={item.accent} title={item.title} badge={item.badge}>
          <p>{item.desc}</p>
        </GlassCard>
      ))}
    </div>
  </section>

  <section class="wrap section" id="faq">
    <div class="section-head" data-reveal><h2>常见问题</h2></div>
    <div class="faq-list">
      {faqs.map(([q, a]) => (
        <details class="glass-content cap-card spotlight-card faq-item" data-spotlight data-reveal>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head" data-reveal><h2>上游致谢</h2></div>
    <div class="glass-content cap-card spotlight-card" data-spotlight data-reveal>
      <ul class="credits">
        {credits.map(([name, lic, desc]) => (
          <li><strong>{name}</strong><span class="cap-chip">{lic}</span><span class="label">{desc}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap section">
    <div class="glass-content cap-card spotlight-card contact" data-spotlight data-reveal>
      <h3>联系与反馈</h3>
      <p class="lead">欢迎通过 GitHub Issues 提交问题与建议，或加入 QQ 交流群（群号：<code>1053622526</code>）交流体验与蹲 iOS 版内测动态。</p>
      <a class="btn btn-secondary" href="https://github.com/STAR-10086/buct-one/issues" target="_blank" rel="noopener">提交 Issue</a>
    </div>
  </section>
</Base>
<style>
  .about-head { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
  .about-head > div { display: grid; gap: 10px; }
  .arch { font-size: 12px; line-height: 20px; overflow-x: auto; color: var(--on-glass); padding: 8px 0; }
  .privacy-points { padding-left: 20px; display: grid; gap: 6px; margin-top: 12px; }
  .privacy-points li { font-size: 14px; line-height: 20px; color: var(--on-glass-variant); }
  .faq-list { display: grid; gap: 12px; }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--on-glass); list-style-position: inside; }
  .faq-item p { margin-top: 8px; font-size: 14px; line-height: 20px; color: var(--on-glass-variant); }
  .credits { list-style: none; display: grid; gap: 10px; }
  .credits li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .credits strong { color: var(--on-glass); }
  .credits .label { color: var(--text-variant); }
  .contact { display: grid; gap: 10px; justify-items: start; }
</style>
